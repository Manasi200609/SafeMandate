SESSION_TTL_MINUTES=480
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_RATE_WINDOW_MS=900000
