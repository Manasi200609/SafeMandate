# Vite proxies /api to this backend origin during development.
SAFE_MANDATE_API_ORIGIN=http://127.0.0.1:3001

# Set this public URL in the Vercel project for Production and Preview builds.
# Use the HTTPS origin of the Safe Mandate Render web service; never put secrets here.
# VITE_API_ORIGIN=https://<safe-mandate-api>.onrender.com
